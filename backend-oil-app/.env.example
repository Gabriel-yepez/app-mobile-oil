DATABASE_URL="postgresql://ruedalo:ruedalo@localhost:5433/ruedalo?schema=public"
JWT_ACCESS_SECRET="cambiame-por-32-caracteres-o-mas-aleatorios"
JWT_REFRESH_SECRET="otro-distinto-de-32-caracteres-o-mas"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"
PORT=3000
CORS_ORIGINS=""

# Intentos de registro/login por minuto y por IP
THROTTLE_AUTH_LIMIT=5

# Documentación interactiva en http://localhost:3000/docs (JSON en /docs-json).
# Ponla en "false" para no publicarla en producción.
SWAGGER_ENABLED=true

# Notificaciones push. EXPO_ACCESS_TOKEN sale de expo.dev -> Access Tokens y
# activa la seguridad reforzada: sin el, cualquiera con un token de push de la
# app puede mandarle notificaciones a tus usuarios.
EXPO_ACCESS_TOKEN=""

# Ponlo en "false" para que los cron de push no se registren (desarrollo, e2e).
PUSH_ENABLED=true
