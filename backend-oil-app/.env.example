DATABASE_URL="postgresql://ruedalo:ruedalo@localhost:5433/ruedalo?schema=public"
JWT_ACCESS_SECRET="cambiame-por-32-caracteres-o-mas-aleatorios"
JWT_REFRESH_SECRET="otro-distinto-de-32-caracteres-o-mas"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"
PORT=3000
CORS_ORIGINS=""

# Intentos de registro/login por minuto y por IP
THROTTLE_AUTH_LIMIT=5

# Documentación interactiva en http://localhost:3000/docs (JSON en /docs-json).
# Ponla en "false" para no publicarla en producción.
SWAGGER_ENABLED=true

# Notificaciones push. EXPO_ACCESS_TOKEN sale de expo.dev -> Access Tokens y
# activa la seguridad reforzada: sin el, cualquiera con un token de push de la
# app puede mandarle notificaciones a tus usuarios.
EXPO_ACCESS_TOKEN=""

# Ponlo en "false" para que los cron de push no se registren (desarrollo, e2e).
PUSH_ENABLED=true

# Recuperar contraseña. Firma los códigos de 6 dígitos que llegan por correo.
# Obligatorio, 32+ caracteres y DISTINTO de los secretos JWT.
RESET_CODE_SECRET="otro-secreto-distinto-de-32-caracteres-o-mas"

# Correo saliente (SMTP). Los valores por defecto apuntan a Mailpit, que
# levanta el docker-compose: los correos no salen a internet y se leen en
# http://localhost:8025. En producción, el proveedor que elijas:
#   Brevo:    SMTP_HOST=smtp-relay.brevo.com  SMTP_PORT=587
#   Resend:   SMTP_HOST=smtp.resend.com       SMTP_PORT=465  SMTP_USER=resend
#   SendGrid: SMTP_HOST=smtp.sendgrid.net     SMTP_PORT=587  SMTP_USER=apikey
# El puerto 465 usa TLS directo; el resto, STARTTLS.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Ruédalo <no-responder@ruedalo.local>"
