# URL base de la API. Solo las variables con prefijo EXPO_PUBLIC_ llegan al
# bundle — y por eso mismo NO son secretas: quedan incrustadas en el binario.
# Nunca pongas acá claves ni tokens; esto es para una URL y poco más.
#
# Simulador de iOS y web:  http://localhost:3000/api/v1
# Dispositivo físico:      la IP de tu Mac en la red local — `ipconfig getifaddr en0`
#                          p.ej. http://192.168.0.107:3000/api/v1
#                          (en el teléfono, "localhost" es el propio teléfono)
EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1
